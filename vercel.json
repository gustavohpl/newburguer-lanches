{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "images": {
    "sizes": [
      96,
      256,
      480,
      828,
      1080
    ],
    "domains": [
      "wgxmknkbzxrntlufqayi.supabase.co"
    ],
    "formats": [
      "image/webp"
    ],
    "minimumCacheTTL": 2592000
  },
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/((?!assets/|prime/|icons/).*)",
      "destination": "/index.html"
    }
  ]
}
